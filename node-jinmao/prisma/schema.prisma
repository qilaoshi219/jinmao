// ==================== Prisma 数据库 Schema 定义 ====================
// 职责：集中定义数据库模型结构，是数据库的唯一来源
// 使用 MySQL 8.0，字符集 utf8mb4，引擎 InnoDB
// 运行 npx prisma migrate dev 自动生成迁移文件并建表

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户表 User ====================
// 参照 数据库结构.md 的设计，与现有 MySQL User 表严格对应
model User {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 用户ID，主键自增
  username    String?   @db.VarChar(50)                                   // 用户名（验证码注册时为 NULL）
  password    String?   @db.VarChar(255)                                  // bcrypt 哈希密码（无密码用户为 NULL）
  nickname    String?   @db.VarChar(50)                                   // 昵称
  email       String    @unique @db.VarChar(100)                          // 邮箱，唯一索引
  phone       String?   @unique @db.VarChar(20)                           // 手机号，可选唯一
  role        String    @default("user") @db.VarChar(10)                  // 角色：admin / user
  createTime  DateTime  @default(now()) @map("create_time")               // 创建时间
  updateTime  DateTime  @updatedAt @map("update_time")                    // 更新时间
  isBanned    Boolean   @default(false) @map("is_banned")                 // 是否被禁用
  banReason   String?   @db.VarChar(255) @map("ban_reason")               // 禁用原因
  isDeleted   Boolean   @default(false) @map("is_deleted")                // 软删除标记
  vipLevel    String    @default("free") @map("vip_level") @db.VarChar(20) // VIP 等级：free / vip1 / vip2 / vip3
  balance     Decimal   @default(0) @db.Decimal(18, 7)                     // 余额（元），精确到小数点后 7 位
  balanceLocked Boolean @default(false) @map("balance_locked")              // 余额是否已锁定（余额<0时自动锁定，充值>0后自动解锁）
  plan        String?   @db.VarChar(50)                                    // 开通计划：null(未开通) / "basic" / "pro"
  avatar      String?   @db.VarChar(512)                                   // 头像 URL（MinIO 存储路径）
  bio         String?   @db.VarChar(200)                                   // 个性签名

  courses          Course[]               // 课程列表
  studyRecords     UserStudyRecord[]    // 用户学习记录
  dailyActivities  UserDailyActivity[]  // 用户每日活动记录
  quizTextbooks    QuizTextbook[]       // 题库列表
  quizSessions     QuizSession[]        // 刷题会话
  quizReports      QuizReport[]         // 刷题报告
  quizUserAnswers  QuizUserAnswer[]     // 作答记录
  quizWrongQuestions QuizWrongQuestion[] // 错题本
  quizBookBorrows    QuizBookBorrow[]    // 借用的题库

  @@map("User") // 映射数据库表名
}

// ==================== 课程表 Course ====================
// 存储用户上传的教材元数据和流水线状态
model Course {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 课程ID，主键自增
  userId             BigInt    @map("user_id") @db.UnsignedBigInt               // 用户ID，外键引用 User 表
  name               String    @db.VarChar(100)                                 // 课程名称（用户自定义或 AI 识别）
  description        String?   @db.Text                                         // 课程描述
  textbookFilename   String    @map("textbook_filename") @db.VarChar(255)       // 教材原文件名
  textbookPath       String    @map("textbook_path") @db.VarChar(500)           // 归一化 MD 在 MinIO 路径，如 /usercourse/1001/2001/教材名-20260705T120000-Ab3Xz9/教材名.md
  sourcePath         String    @map("source_path") @db.VarChar(512)             // 源文件在 MinIO 路径，如 /usercourse/1001/2001/闸门运行工教材.pdf
  coverPath          String?   @map("cover_path") @db.VarChar(512)              // 封面图片路径（暂不生成，预留字段）
  subtitle           String?   @db.VarChar(200)                                 // 课程副标题（AI 生成）
  elaborationEnabled Boolean   @default(true) @map("elaboration_enabled")       // 是否开启文本细化（用户上传时勾选，默认 true）
  endline            Int       @default(0) @map("endline") @db.UnsignedInt      // 当前已处理到的行号（流水线从该位置继续提取文本）
  maxline            Int       @default(0) @map("maxline") @db.UnsignedInt       // MD 文件总行数（持久化的权威值，用于判断教材是否已全部生成完毕）
  pipelineStatus     String    @default("idle") @map("pipeline_status") @db.VarChar(30) // 流水线状态（idle/extracting/indexing/.../completed）
  pipelineProgress   String?   @map("pipeline_progress") @db.VarChar(1000)      // 流水线进度 JSON（outlineStartTime/totalSlides/elaborationCompleted/filesCompleted）
  createTime         DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime         DateTime  @updatedAt @map("update_time")                   // 更新时间
  isDeleted          Boolean   @default(false) @map("is_deleted")               // 软删除标记

  chapters           Chapter[]                                                    // 章节列表（Prisma 虚拟关系）
  user               User     @relation(fields: [userId], references: [id])       // 所属用户
  studyRecords       UserStudyRecord[]                                            // 该课程的学习记录（Prisma 虚拟关系）

  @@map("Course")
}

// ==================== 章节表 Chapter ====================
// 存储每章元数据，PPT/语音/字幕文件通过 MinIO 目录结构关联
model Chapter {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 章节ID，主键自增
  courseId      BigInt    @map("course_id") @db.UnsignedBigInt             // 课程ID，外键引用 Course 表
  sequence      Int       @db.UnsignedInt                                  // 章节序号（1, 2, 3...）
  name          String    @db.VarChar(100)                                 // 章节名称（AI 识别或手动指定）
  description   String?   @db.Text                                         // 章节描述
  chapterRoot   String    @map("chapter_root") @db.VarChar(500)            // MinIO 章节根目录，如 /usercourse/1001/2001/chapter_01/
  startline     Int       @db.UnsignedInt                                  // 本章在原始文件中的起始行号
  endline       Int       @db.UnsignedInt                                  // 本章在原始文件中的结束行号
  totalPages    Int       @default(0) @map("total_pages") @db.UnsignedInt  // 本章 PPT 总页数
  outlinePath   String?   @map("outline_path") @db.VarChar(512)            // 大纲 JSON 路径，如 /usercourse/1001/2001/chapter_01/chapter_01.json
  status        String    @default("pending") @db.VarChar(20)              // 章节状态：pending/generating/completed/failed
  generationProgress String? @map("generation_progress") @db.VarChar(1000) // 章节生成流水线进度 JSON（{ phase, outlineProgress, elaborationProgress, filesProgress }），仅 generating 状态时有值，完成后清空
  createTime    DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime    DateTime  @updatedAt @map("update_time")                   // 更新时间
  isDeleted     Boolean   @default(false) @map("is_deleted")               // 软删除标记

  course        Course    @relation(fields: [courseId], references: [id])  // 所属课程

  studyRecords  UserStudyRecord[]                                             // 该章节的学习记录（Prisma 虚拟关系）

  @@map("Chapter")
}

// ==================== 用户学习记录表 UserStudyRecord ====================
// 参照 数据库结构.md 的设计，记录用户每个课程-章节的学习进度
// 联合唯一约束：(user_id, course_id, chapter_id)，每个用户每课程每章节仅一条记录
model UserStudyRecord {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 记录ID，主键自增
  userId        BigInt    @map("user_id") @db.UnsignedBigInt               // 用户ID，外键引用 User 表
  courseId      BigInt    @map("course_id") @db.UnsignedBigInt             // 课程ID，外键引用 Course 表
  chapterId     BigInt    @map("chapter_id") @db.UnsignedBigInt            // 章节ID，外键引用 Chapter 表
  progress      Int       @default(0) @db.UnsignedInt                      // 用户学到该章节第几页PPT（1-based）
  studyDuration Int       @default(0) @map("study_duration") @db.UnsignedInt // 学习时长（秒），预留字段，暂不实现
  createTime    DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime    DateTime  @updatedAt @map("update_time")                   // 更新时间
  isDeleted     Boolean   @default(false) @map("is_deleted")               // 软删除标记

  user          User      @relation(fields: [userId], references: [id])    // 所属用户
  course        Course    @relation(fields: [courseId], references: [id])  // 所属课程
  chapter       Chapter   @relation(fields: [chapterId], references: [id]) // 所属章节

  @@unique([userId, courseId, chapterId]) // 联合唯一约束：同一用户同一课程同一章节仅一条记录
  @@map("UserStudyRecord")
}

// ==================== 用户每日活动记录表 UserDailyActivity ====================
// 记录用户每天是否有学习/刷题活动，用于计算连续学习天数
// 联合唯一约束：(userId, activityDate)，同一用户同一天仅一条记录
model UserDailyActivity {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt // 记录ID，主键自增
  userId       BigInt   @map("user_id") @db.UnsignedBigInt               // 用户ID，外键引用 User 表
  activityDate DateTime @map("activity_date") @db.Date                   // 活动日期（精确到天）
  createTime   DateTime @default(now()) @map("create_time")              // 创建时间

  user User @relation(fields: [userId], references: [id])               // 所属用户

  @@unique([userId, activityDate]) // 联合唯一约束：同一用户同一天仅一条记录
  @@map("UserDailyActivity")
}

// ==================== 计费记录表 billing_record ====================
// 记录用户使用 LLM / TTS / 文生图等 API 的每次调用费用明细
// user_id 存储 JWT 中的 userId 字符串值（与 User 表 BigInt id 的字符串形式一致）
model billing_record {
  id                   Int      @id @default(autoincrement())
  user_id              String   @db.VarChar(50)                            // 用户 ID（JWT 中的 userId 字符串）
  provider             String   @db.VarChar(20)                            // 提供商：deepseek / grsai / volcengine
  model                String   @db.VarChar(50)                            // 模型名称
  call_tag             String   @db.VarChar(30)                            // 调用标签：elaboration / outline / title / getline / htmlppt / create_image / tts / doc2x
  status               String   @default("success") @db.VarChar(10)        // success / failed
  prompt_tokens        Int?                                                // 输入总 token 数（LLM 专用）
  cache_hit_tokens     Int?                                                // 缓存命中 token 数（LLM 专用）
  cache_miss_tokens    Int?                                                // 缓存未命中 token 数（LLM 专用）
  completion_tokens    Int?                                                // 输出 token 数（LLM 专用）
  total_tokens         Int?                                                // 总 token 数（LLM 专用）
  image_count          Int?                                                // 图片数量（文生图专用）
  image_resolution     String?   @db.VarChar(20)                           // 图片分辨率（文生图专用，仅日志记录）
  text_length          Int?                                                // 文本长度（字符数，TTS 专用）
  audio_duration       Float?                                              // 音频时长（秒，TTS 专用，可选）
  page_count           Int?                                                // 页数（doc2x PDF解析专用）
  time_period          String    @default("default") @db.VarChar(20)       // 计费时段名称
  input_unit_price     Decimal?  @db.Decimal(18, 7)                        // 输入单价（元/百万tokens，缓存未命中）
  input_cache_hit_price Decimal? @db.Decimal(18, 7)                        // 输入单价（元/百万tokens，缓存命中，LLM 专用）
  output_unit_price    Decimal?  @db.Decimal(18, 7)                        // 输出单价（元/百万tokens，LLM 专用）
  image_unit_price     Decimal?  @db.Decimal(18, 7)                        // 图片单价（元/张，文生图专用）
  tts_unit_price       Decimal?  @db.Decimal(18, 7)                        // TTS 单价（元/字符，TTS 专用）
  page_unit_price      Decimal?  @db.Decimal(18, 7)                        // 每页单价（元/页，doc2x 专用）
  input_cost           Decimal?  @db.Decimal(18, 7)                        // 输入费用（元）
  output_cost          Decimal?  @db.Decimal(18, 7)                        // 输出费用（元）
  total_cost           Decimal   @db.Decimal(18, 7)                        // 总费用（元）
  error_message        String?   @db.Text                                   // 失败原因（仅 status=failed 时记录，方便排查问题）
  retry_count          Int       @default(0)                                // 重试次数（0 表示首次调用，最多重试 3 次）
  created_at           DateTime  @default(now())                           // 创建时间

  @@index([user_id])
  @@index([created_at])
  @@map("billing_record")
}

// ==================== 题库表 QuizTextbook ====================
// 存储用户导入的题库元数据，与 Course 表独立，互不干扰
model QuizTextbook {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 题库ID，主键自增
  userId         BigInt    @map("user_id") @db.UnsignedBigInt               // 用户ID，外键引用 User 表
  name           String    @db.VarChar(100)                                 // 题库名称
  description    String?   @db.Text                                         // 题库描述
  totalQuestions Int       @default(0) @map("total_questions")              // 题目总数
  totalExams     Int       @default(0) @map("total_exams")                  // 试卷总数
  createTime     DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime     DateTime  @updatedAt @map("update_time")                   // 更新时间
  isDeleted      Boolean   @default(false) @map("is_deleted")               // 软删除标记
  isShared       Boolean   @default(false) @map("is_shared")                // 是否共享到题库市场
  generatingTaskId String? @map("generating_task_id") @db.VarChar(36)       // 关联的后台生成任务ID（有值时表示正在生成中）

  user           User      @relation(fields: [userId], references: [id])    // 所属用户
  exams          QuizExam[]                                                  // 试卷列表
  questions      QuizQuestion[]                                              // 题目列表
  wrongQuestions QuizWrongQuestion[]                                         // 错题关联
  quizSessions   QuizSession[]                                               // 刷题会话
  quizReports    QuizReport[]                                                // 刷题报告
  borrows        QuizBookBorrow[]                                            // 借用记录

  @@map("QuizTextbook")
}

// ==================== 试卷表 QuizExam ====================
// 一个题库可以有多张试卷
model QuizExam {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 试卷ID，主键自增
  textbookId    BigInt    @map("textbook_id") @db.UnsignedBigInt           // 题库ID，外键引用 QuizTextbook 表
  name          String    @db.VarChar(100)                                 // 试卷名称
  questionCount Int       @default(0) @map("question_count")              // 题目数量
  createTime    DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime    DateTime  @updatedAt @map("update_time")                   // 更新时间

  textbook      QuizTextbook   @relation(fields: [textbookId], references: [id]) // 所属题库
  questions     QuizQuestion[]                                                   // 题目列表
  quizSessions  QuizSession[]                                                    // 刷题会话

  @@map("QuizExam")
}

// ==================== 题目表 QuizQuestion ====================
// 存储每道题目的完整信息，支持 5 种题型
model QuizQuestion {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt // 题目ID，主键自增
  examId      BigInt       @map("exam_id") @db.UnsignedBigInt              // 试卷ID，外键引用 QuizExam 表
  textbookId  BigInt       @map("textbook_id") @db.UnsignedBigInt          // 题库ID，外键引用 QuizTextbook 表
  type        QuizQuestionType                                             // 题型枚举
  content     String       @db.Text                                         // 题干内容
  options     Json?                                                         // 选项 JSON [{key, value}]，仅单选/多选题使用
  answer      String       @db.Text                                         // 正确答案（单选:A, 多选:A,B, 判断:正确/错误, 填空/简答:文本）
  analysis    String?      @db.Text                                         // 题目解析
  difficulty  Int          @default(1)                                      // 难度等级 1-5
  sortOrder   Int          @default(0) @map("sort_order")                  // 排序序号
  createTime  DateTime     @default(now()) @map("create_time")              // 创建时间
  updateTime  DateTime     @updatedAt @map("update_time")                   // 更新时间

  exam             QuizExam           @relation(fields: [examId], references: [id])      // 所属试卷
  textbook         QuizTextbook       @relation(fields: [textbookId], references: [id])  // 所属题库
  userAnswers      QuizUserAnswer[]                                                      // 作答记录
  wrongQuestions   QuizWrongQuestion[]                                                    // 错题关联
  quizReportItems  QuizReportItem[]                                                       // 报告题目明细

  @@map("QuizQuestion")
}

// 题目类型枚举
enum QuizQuestionType {
  SINGLE    // 单选题
  MULTIPLE  // 多选题
  JUDGE     // 判断题
  FILL      // 填空题
  ESSAY     // 简答题
}

// ==================== 作答记录表 QuizUserAnswer ====================
// 记录用户每次作答的详细信息
model QuizUserAnswer {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 记录ID，主键自增
  userId      BigInt    @map("user_id") @db.UnsignedBigInt               // 用户ID
  questionId  BigInt    @map("question_id") @db.UnsignedBigInt           // 题目ID
  sessionId   BigInt?   @map("session_id") @db.UnsignedBigInt            // 会话ID（可选，用于关联刷题会话）
  userAnswer  String    @map("user_answer") @db.Text                     // 用户答案
  isCorrect   Boolean   @map("is_correct") @db.TinyInt                   // 是否正确
  timeSpent   Int       @default(0) @map("time_spent")                   // 答题耗时（秒），预留字段
  createTime  DateTime  @default(now()) @map("create_time")              // 创建时间

  user      User          @relation(fields: [userId], references: [id])       // 所属用户
  question  QuizQuestion  @relation(fields: [questionId], references: [id])   // 关联题目
  session   QuizSession?  @relation(fields: [sessionId], references: [id])    // 关联会话

  @@map("QuizUserAnswer")
}

// ==================== 错题本表 QuizWrongQuestion ====================
// 用户做错的题目记录，userId + questionId 联合唯一
model QuizWrongQuestion {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt // 记录ID，主键自增
  userId      BigInt    @map("user_id") @db.UnsignedBigInt               // 用户ID
  questionId  BigInt    @map("question_id") @db.UnsignedBigInt           // 题目ID
  textbookId  BigInt    @map("textbook_id") @db.UnsignedBigInt           // 题库ID
  wrongCount  Int       @default(1) @map("wrong_count")                  // 错误次数
  createTime  DateTime  @default(now()) @map("create_time")              // 创建时间
  updateTime  DateTime  @updatedAt @map("update_time")                   // 更新时间

  user      User          @relation(fields: [userId], references: [id])       // 所属用户
  question  QuizQuestion  @relation(fields: [questionId], references: [id])   // 关联题目
  textbook  QuizTextbook  @relation(fields: [textbookId], references: [id])   // 关联题库

  @@unique([userId, questionId]) // 同一用户同一题目仅一条错题记录
  @@map("QuizWrongQuestion")
}

// ==================== 刷题会话表 QuizSession ====================
// 记录用户每次刷题会话的状态和进度
model QuizSession {
  id                   BigInt        @id @default(autoincrement()) @db.UnsignedBigInt // 会话ID，主键自增
  userId               BigInt        @map("user_id") @db.UnsignedBigInt               // 用户ID
  textbookId           BigInt?       @map("textbook_id") @db.UnsignedBigInt           // 题库ID（随机刷题时有值）
  examId               BigInt?       @map("exam_id") @db.UnsignedBigInt               // 试卷ID（预留，暂不使用）
  mode                 QuizMode                                                       // 刷题模式枚举
  questionIds          Json          @map("question_ids")                             // 题目ID数组 [id1, id2, ...]
  totalCount           Int           @default(0) @map("total_count")                  // 题目总数
  correctCount         Int           @default(0) @map("correct_count")                // 正确题目数
  currentQuestionIndex Int           @default(1) @map("current_question_index")       // 当前题目序号 (1-based)
  lastAnsweredAt       DateTime?     @map("last_answered_at")                         // 最后作答时间
  status               QuizSessionStatus @default(IN_PROGRESS)                        // 会话状态
  createTime           DateTime      @default(now()) @map("create_time")              // 创建时间
  updateTime           DateTime      @updatedAt @map("update_time")                   // 更新时间

  user        User              @relation(fields: [userId], references: [id])       // 所属用户
  textbook    QuizTextbook?     @relation(fields: [textbookId], references: [id])   // 关联题库
  exam        QuizExam?         @relation(fields: [examId], references: [id])       // 关联试卷
  userAnswers QuizUserAnswer[]                                                       // 作答记录
  report      QuizReport?                                                            // 刷题报告（一对一）

  @@map("QuizSession")
}

// 刷题模式枚举
enum QuizMode {
  RANDOM      // 随机刷题
  REVIEW      // 错题复习
  SEQUENTIAL  // 顺序刷题（预留）
  EXAM        // 试卷模式（预留）
}

// 会话状态枚举
enum QuizSessionStatus {
  IN_PROGRESS // 进行中
  COMPLETED   // 已完成
  ABANDONED   // 已放弃
}

// ==================== 刷题报告表 QuizReport ====================
// 记录每次刷题交卷后的成绩报告
model QuizReport {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt // 报告ID，主键自增
  userId          BigInt            @map("user_id") @db.UnsignedBigInt               // 用户ID
  sessionId       BigInt            @unique @map("session_id") @db.UnsignedBigInt    // 会话ID（一对一）
  textbookId      BigInt?           @map("textbook_id") @db.UnsignedBigInt           // 题库ID
  status          QuizReportStatus  @default(PENDING)                                // 报告状态
  totalCount      Int               @default(0) @map("total_count")                  // 题目总数
  objectiveCount  Int               @default(0) @map("objective_count")              // 客观题数量
  essayCount      Int               @default(0) @map("essay_count")                  // 简答题数量
  scoreObjective  Float             @default(0) @map("score_objective")              // 客观题得分
  scoreEssay      Float             @default(0) @map("score_essay")                  // 简答题得分
  scoreTotal      Float             @default(0) @map("score_total")                  // 总分（满分100）
  createTime      DateTime          @default(now()) @map("create_time")              // 创建时间
  updateTime      DateTime          @updatedAt @map("update_time")                   // 更新时间

  user      User              @relation(fields: [userId], references: [id])        // 所属用户
  session   QuizSession       @relation(fields: [sessionId], references: [id])     // 关联会话
  textbook  QuizTextbook?     @relation(fields: [textbookId], references: [id])    // 关联题库
  items     QuizReportItem[]                                                         // 报告题目明细

  @@map("QuizReport")
}

// 报告状态枚举
enum QuizReportStatus {
  PENDING   // 待批改
  GRADING   // 批改中
  COMPLETED // 已完成
  FAILED    // 失败
}

// ==================== 报告题目明细表 QuizReportItem ====================
// 记录报告中每道题目的评分详情
model QuizReportItem {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt // 明细ID，主键自增
  reportId        BigInt                @map("report_id") @db.UnsignedBigInt             // 报告ID
  questionId      BigInt                @map("question_id") @db.UnsignedBigInt           // 题目ID
  questionType    QuizQuestionType      @map("question_type")                            // 题型
  maxScore        Float                 @default(0) @map("max_score")                    // 满分值
  score           Float                 @default(0)                                      // 实际得分
  isCorrect       Boolean?              @map("is_correct") @db.TinyInt                   // 是否正确（客观题有值，简答题为null）
  userAnswer      String?               @map("user_answer") @db.Text                     // 用户答案
  referenceAnswer String?               @map("reference_answer") @db.Text                // 参考答案
  aiPercent       Float?                @map("ai_percent")                               // AI判题百分比（简答题专用）
  aiCommentary    String?               @map("ai_commentary") @db.Text                   // AI判题评语（简答题专用）
  status          QuizReportItemStatus  @default(PENDING)                                // 判题状态
  createTime      DateTime              @default(now()) @map("create_time")              // 创建时间
  updateTime      DateTime              @updatedAt @map("update_time")                   // 更新时间

  report   QuizReport   @relation(fields: [reportId], references: [id])    // 关联报告
  question QuizQuestion @relation(fields: [questionId], references: [id])  // 关联题目

  @@unique([reportId, questionId]) // 同一报告同一题目仅一条明细
  @@map("QuizReportItem")
}

// 报告题目判题状态枚举
enum QuizReportItemStatus {
  PENDING // 待批改
  RUNNING // 批改中
  DONE    // 已完成
  FAILED  // 失败
}

// ==================== 题库借用表 QuizBookBorrow ====================
// 记录用户借用的共享题库，联合唯一约束 (userId, textbookId)
// 借用者与被借用题库的多对多关联表
model QuizBookBorrow {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt  // 记录ID，主键自增
  userId     BigInt   @map("user_id") @db.UnsignedBigInt                // 借用者用户ID
  textbookId BigInt   @map("textbook_id") @db.UnsignedBigInt            // 被借用的题库ID
  createTime DateTime @default(now()) @map("create_time")               // 借用时间

  user     User         @relation(fields: [userId], references: [id])       // 借用者
  textbook QuizTextbook @relation(fields: [textbookId], references: [id])   // 题库

  @@unique([userId, textbookId]) // 同一用户同一题库只能借用一次
  @@map("QuizBookBorrow")
}

// ==================== 兑换码表 redeem_code ====================
// 存储管理员生成的兑换码，用户可输入兑换码领取余额（一次性使用，不记名）
model redeem_code {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt  // 兑换码ID，主键自增
  code       String    @unique @db.VarChar(32)                           // 兑换码（随机生成，唯一索引）
  amount     Decimal   @default(10) @db.Decimal(18, 7)                  // 兑换金额（元），默认10元
  isUsed     Boolean   @default(false) @map("is_used")                   // 是否已使用
  usedBy     BigInt?   @map("used_by") @db.UnsignedBigInt               // 使用者ID（外键引用User表，NULL表示未使用）
  usedAt     DateTime? @map("used_at")                                   // 使用时间（NULL表示未使用）
  createdBy  BigInt?   @map("created_by") @db.UnsignedBigInt            // 创建者ID（管理员）
  createdAt  DateTime  @default(now()) @map("created_at")               // 创建时间

  @@index([code])
  @@index([isUsed])
  @@map("redeem_code")
}

// ==================== 安全事件表 SecurityEvent ====================
// 记录被安全防护中间件检测到的可疑攻击请求，供管理员后台分析研究
// 同 IP 同攻击类型在 5 分钟窗口内的重复攻击会合并为一条记录（count 累加），防止扫描器刷爆数据库
model SecurityEvent {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt // 事件ID，主键自增
  ip         String   @db.VarChar(45)          // 攻击者IP（IPv6 地址最长 45 字符）
  method     String   @db.VarChar(10)          // 请求方法（GET/POST/...）
  path       String   @db.Text                 // 完整请求路径（攻击载荷可能超长，使用 Text 类型）
  query      String?  @db.Text                 // 完整 query 参数（原始字符串，可能超长）
  userAgent  String?  @db.VarChar(500)         // User-Agent 请求头
  attackType String   @db.VarChar(50)          // 攻击类型：sql_injection/xss/path_traversal/oversized_url/path_param_abuse/sensitive_file/scanner_path/malicious_ua
  severity   String   @db.VarChar(20)          // 严重程度：low / medium / high
  reason     String   @db.VarChar(500)         // 触发原因描述（命中的检测规则）
  blocked    Boolean  @default(true)           // 是否被防护中间件阻断
  handled    Boolean  @default(false)          // 管理员是否已标记处理
  count      Int      @default(1)              // 同IP同类型5分钟窗口内的触发次数（去重合并计数）
  createTime DateTime @default(now()) @map("create_time") // 首次触发时间

  @@index([ip])
  @@index([attackType])
  @@index([createTime])
  @@map("SecurityEvent")
}
