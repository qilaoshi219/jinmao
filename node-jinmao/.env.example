# ============ 敏感凭据配置模板 ============
# 复制此文件为 .env 并填写真实凭据：cp .env.example .env
# 此文件可以提交到版本控制，因为它不包含真实凭据

# ============ 服务端口 ============
# 测试环境 8888；生产环境 8889（宝塔网站 30081 反代到该端口）
PORT=8888

# ============ 数据库连接（Prisma） ============
# 测试环境库名 jinmao；生产环境库名 jinmao_prod（见 双环境部署指南.md）
DATABASE_URL="mysql://jinmao:你的数据库密码@127.0.0.1:3306/jinmao?charset=utf8mb4"

# ============ JWT 配置 ============
# 建议格式如 jinmao_jwt_2026_xxxxxxxx（至少 32 位随机字符）；生产环境请独立生成
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# ============ SMTP 邮箱配置（nodemailer） ============
SMTP_HOST="smtp.163.com"
SMTP_PORT="465"
SMTP_USER="your-email@163.com"
SMTP_PASS="your-smtp-auth-code"
SMTP_FROM="创客工作室 <your-email@163.com>"

# ============ DeepSeek API ============
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============ Doc2x API ============
DOC2X_API_KEY=your_doc2x_api_key_here

# ============ 火山引擎 TTS ============
VOLCENGINE_TTS_APP_ID=your_volcengine_app_id_here
VOLCENGINE_TTS_ACCESS_KEY=your_volcengine_access_key_here

# ============ MinIO 对象存储 ============
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
# 测试环境桶名 jinmao；生产环境桶名 jinmao-prod
MINIO_BUCKET=jinmao

# ============ Grsai 文生图 API ============
GRSAI_API_KEY=your_grsai_api_key_here
GRSAI_MODEL=gpt-image-2
